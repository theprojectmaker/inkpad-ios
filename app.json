{
  "expo": {
    "name": "Quill",
    "slug": "inkpad",
    "version": "1.2.0",
    "orientation": "default",
    "scheme": "inkpad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.solyapps.notes",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Quill",
        "NSSpeechRecognitionUsageDescription": "Quill turns what you record into text you can read and search, and uses it to write your notes.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Quill Note",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.solyapps.quill.note"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.solyapps.quill.note",
            "UTTypeDescription": "Quill Note",
            "UTTypeConformsTo": ["public.json", "public.content"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["quill"],
              "public.mime-type": ["application/vnd.quill.note+json"]
            }
          }
        ]
      },
      "isTabletOnly": true
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Quill opens the photos you pick so you can add them to a note.",
          "cameraPermission": "Quill uses the camera to scan your paper notes and worksheets into clean typed copies."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Quill uses the microphone only while you tap Record, to save audio with your notes.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "InkpadShare",
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 20,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": [
            "image/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "application/pdf"
          ]
        }
      ],
      [
        "./plugins/with-share-display-name",
        {
          "target": "InkpadShare",
          "displayName": "Quill"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/with-ipad-only"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa46b175-bd32-4365-ab6c-dfc3354db0e5"
      }
    },
    "owner": "solomonsasson",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/fa46b175-bd32-4365-ab6c-dfc3354db0e5"
    },
    "icon": "./assets/icon.png"
  }
}
