{
  "expo": {
    "name": "Inkpad",
    "slug": "inkpad",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "inkpad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.solyapps.notes",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Inkpad"
      }
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Inkpad opens the photos you pick so you can add them to a note.",
          "cameraPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Inkpad uses the microphone only while you tap Record, to save audio with your notes."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "InkpadShare",
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 20,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": [
            "image/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "application/pdf"
          ]
        }
      ],
      [
        "./plugins/with-share-display-name",
        {
          "target": "InkpadShare",
          "displayName": "Inkpad"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F2",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa46b175-bd32-4365-ab6c-dfc3354db0e5"
      }
    },
    "owner": "solomonsasson",
    "updates": {
      "url": "https://u.expo.dev/fa46b175-bd32-4365-ab6c-dfc3354db0e5"
    },
    "icon": "./assets/icon.png"
  }
}
